# AFET360 Frontend - environment variables
# Copy this file to .env.local and fill in the values.
# Do not commit real keys.

# Project backend base URL (e.g. http://localhost:8000)
VITE_API_BASE_URL=

# Optional local Vite proxy: set VITE_API_BASE_URL=/backend and supply the backend
# origin here in .env.local. Not exposed in the browser; production needs hosting configuration.
API_PROXY_TARGET=

# Google Maps JavaScript API key for /simulation; store the real value in .env.local.
VITE_GOOGLE_MAPS_API_KEY=

# Optional Google map ID for AdvancedMarker. Google's DEMO_MAP_ID is used for development.
VITE_GOOGLE_MAPS_MAP_ID=
