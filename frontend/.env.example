# AFET360 Frontend - environment variables
# Copy this file to .env.local and fill in the values.
# Do not commit real keys.

# Project backend base URL.
# - Optional for local Vite development: Vite automatically proxies /api to http://127.0.0.1:8000.
# - Set this only when frontend and backend are deployed on separate origins (e.g. https://api.example.com).
# - Leave blank for same-origin or reverse-proxy deployments.
VITE_API_BASE_URL=

# Google Maps JavaScript API key for map routes; store the real value in .env.local.
VITE_GOOGLE_MAPS_API_KEY=
