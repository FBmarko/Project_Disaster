# ==============================================================================
# AFET360 — Production Environment Configuration Example
# Copy this file to deploy/.env.production and fill in real production values.
# DO NOT commit deploy/.env.production to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUBLIC_BROWSER_CONFIG
# These values are baked into the frontend client build and visible to browsers.
# ------------------------------------------------------------------------------

# Google Maps JavaScript API key for interactive map displays (assembly areas and PGA scenarios).
# In production, restrict this key in Google Cloud Console to your production
# domain HTTP referrer (e.g., https://afet360.example.com/*). Enable ONLY the
# Maps JavaScript API required by current frontend components; do not enable unused APIs.
VITE_GOOGLE_MAPS_API_KEY=YOUR_RESTRICTED_GOOGLE_MAPS_API_KEY

# ------------------------------------------------------------------------------
# 2. SERVER_SECRET
# Sensitive secrets used only by backend and database containers. Never exposed.
# ------------------------------------------------------------------------------

# Strong password for PostgreSQL/PostGIS database. (REQUIRED)
POSTGRES_PASSWORD=CHANGE_ME_TO_A_SECURE_RANDOM_PASSWORD

# Google Gemini API key (OPTIONAL: only required if AI_PROVIDER=gemini).
# Leave blank if using local Ollama.
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 3. NON_SECRET_SERVER_CONFIG
# Operational and networking configuration for Caddy, FastAPI, and database.
# ------------------------------------------------------------------------------

# Caddy site address.
# - For public HTTPS with automatic Let's Encrypt / ACME TLS:
#     SITE_ADDRESS=https://afet360.example.com
# - For local testing or IP access without automated TLS:
#     SITE_ADDRESS=:80
SITE_ADDRESS=https://afet360.example.com

# Public ingress ports bound to the host (defaults: 80 and 443).
# Override only for local testing or custom ingress setups.
WEB_HTTP_PORT=80
WEB_HTTPS_PORT=443

# PostgreSQL connection parameters
POSTGRES_DB=afet360
POSTGRES_USER=afet360

# AI Provider selection: 'ollama' (default) or 'gemini'
AI_PROVIDER=ollama

# Local Ollama configuration (internal Docker networking)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3.5:2b-q4_K_M

# Trusted proxy client IP forwarding (default: '*' within internal Docker network)
# FORWARDED_ALLOW_IPS=*

# Optional CORS allowed origins (same-origin reverse proxy does not require CORS)
# CORS_ALLOWED_ORIGINS=https://afet360.example.com
