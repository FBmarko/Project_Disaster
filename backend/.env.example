APP_NAME=AFET360 API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
API_V1_PREFIX=/api/v1

# Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=afet360
POSTGRES_USER=afet360
POSTGRES_PASSWORD=afet360_dev_password

# AI Provider Configuration (Google Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=30.0

# CORS Configuration (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate Limiting Configuration (per process in-memory)
API_RATE_LIMIT_REQUESTS=120
API_RATE_LIMIT_WINDOW_SECONDS=60
AI_RATE_LIMIT_REQUESTS=5
AI_RATE_LIMIT_WINDOW_SECONDS=60

# Request Body Size Limit (bytes, default: 64 KiB)
API_MAX_REQUEST_BODY_BYTES=65536
